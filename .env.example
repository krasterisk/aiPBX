# Frontend environment variables
# Copy to .env.local for local development (gitignored)

# API & WebSocket
API_URL=http://localhost:5005/api
WS_URL=ws://localhost:3033
STATIC_URL=http://localhost:5005/static

# Dev server
PORT=3005

# Auth integrations
GOOGLE_CLIENT_ID=
TELEGRAM_BOT_ID=

# Payments (publishable keys only — never secret keys)
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Error monitoring (optional — leave empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Analytics (optional — leave empty to disable)
# Public client-side tracking IDs only — not secrets
YANDEX_METRIKA_ID=
# Real prod value: G-G1KZQCKP5D
GA4_MEASUREMENT_ID=
# Canonical site origin for meta/OG/hreflang + prerender postProcess (EU default)
SITE_URL=https://aipbx.net
GOOGLE_ADS_ID=AW-16711221644
ADS_SIGNUP_LABEL=-B6_CK72wtMcEIyDxKA-

# Docker / [deploy:1] EU frontend build:
# Pass SITE_URL, GA4_MEASUREMENT_ID, GOOGLE_ADS_ID, ADS_SIGNUP_LABEL as Dockerfile ARGs
# (see Dockerfile). Builder uses apt chromium + PUPPETEER_EXECUTABLE_PATH for prerender.
# Local Windows: set PUPPETEER_EXECUTABLE_PATH to Chrome if puppeteer Chromium was skipped.
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Cypress E2E (copy cypress.env.example.json → cypress.env.json)
# API_URL=http://localhost:5005/api
